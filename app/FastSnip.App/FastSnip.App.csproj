<Project Sdk="Microsoft.NET.Sdk">

  <!-- FastSnip app window: captures gallery, editor, settings and first-run setup.
       Started on demand by the core (fastsnip.exe); uses no memory while closed.
       Self-contained: .NET and the Windows App SDK ship inside the package. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FastSnip.App</RootNamespace>
    <AssemblyName>FastSnip.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- None for development runs; packaging/build.ps1 builds the MSIX. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version>0.1.0</Version>
    <Product>FastSnip</Product>
    <Copyright>GPL-3.0-or-later</Copyright>
    <CoreExe>$(MSBuildThisFileDirectory)..\..\core\target\release\fastsnip.exe</CoreExe>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Rust core ships next to the app. -->
    <Content Include="$(CoreExe)" Link="fastsnip.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(CoreExe)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

</Project>
