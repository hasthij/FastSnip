<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FastSnip.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <!-- Selected tool: soft neutral fill + accent outline (keeps the line icons readable). -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2A808080" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#38808080" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#22808080" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}" />

        <Style x:Key="ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Nothing open -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
            <FontIcon Glyph="&#xE70F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Pick a capture to edit" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Open one from Captures, or click the thumbnail in the toast that appears after a snip." />
            <Button Content="Go to Captures" HorizontalAlignment="Center" Click="GoCaptures_Click" />
        </StackPanel>

        <!-- Image editor -->
        <Grid x:Name="ImageEditor" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="236" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="3" Padding="16,4,16,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)"><FontIcon Glyph="&#xE7A7;" FontSize="15" /></Button>
                    <Button Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="Redo_Click" ToolTipService.ToolTip="Redo (Ctrl+Y)"><FontIcon Glyph="&#xE7A6;" FontSize="15" /></Button>
                    <Rectangle Width="1" Height="20" Margin="4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button Click="Copy_Click" ToolTipService.ToolTip="Copy (Ctrl+C)">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy" /></StackPanel>
                    </Button>
                    <Button Click="SaveCopy_Click" ToolTipService.ToolTip="Save a copy (Ctrl+Shift+S)" Content="Save copy" />
                    <Button Style="{StaticResource AccentButtonStyle}" Click="Save_Click" ToolTipService.ToolTip="Save over the original (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Save" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tools -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0,1,1,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel x:Name="Rail" Spacing="2" Padding="7,6">
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="select" Click="Tool_Click" ToolTipService.ToolTip="Select and move (V)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M5,3 L5,15 L8.2,12 L10.6,17 L12.4,16.2 L10,11.3 L14.5,11.3 Z" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="crop" Click="Tool_Click" ToolTipService.ToolTip="Crop (C)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M6,2 V14 H18 M2,6 H14 V18" /></Canvas>
                    </ToggleButton>
                    <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="pen" Click="Tool_Click" ToolTipService.ToolTip="Pen (P)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M3,17 L4,13 L13.5,3.5 L16.5,6.5 L7,16 Z M11.5,5.5 L14.5,8.5" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="highlighter" Click="Tool_Click" ToolTipService.ToolTip="Highlighter (H)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M3,17.5 H8.5 M6.5,14 L14,6.5 L17,9.5 L9.5,17 L6.5,17 Z" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="arrow" Click="Tool_Click" ToolTipService.ToolTip="Arrow (A)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M4,16 L16,4 M8,4 H16 V12" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="line" Click="Tool_Click" ToolTipService.ToolTip="Line (L)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M4,16 L16,4" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="box" Click="Tool_Click" ToolTipService.ToolTip="Rectangle (B)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M3.5,5 H16.5 V15 H3.5 Z" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="ellipse" Click="Tool_Click" ToolTipService.ToolTip="Ellipse (E)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M3,10 A7,5 0 1 0 17,10 A7,5 0 1 0 3,10 Z" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="text" Click="Tool_Click" ToolTipService.ToolTip="Text (T)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M4,5.5 V3.5 H16 V5.5 M10,3.5 V16.5 M7.5,16.5 H12.5" /></Canvas>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="step" Click="Tool_Click" ToolTipService.ToolTip="Step number (N)">
                        <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1.6" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}">
                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="pixelate" Click="Tool_Click" ToolTipService.ToolTip="Pixelate (X)">
                        <Canvas Width="20" Height="20"><Path Style="{StaticResource Ico}" Data="M3,3 H17 V17 H3 Z M10,3 V17 M3,10 H17 M3,6.5 H6.5 V10 M13.5,10 V13.5 H17" /></Canvas>
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Canvas -->
            <Grid x:Name="CanvasHost" Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <canvas:CanvasControl x:Name="Surface" UseSharedDevice="True" Draw="Surface_Draw"
                                      PointerPressed="Surface_PointerPressed" PointerMoved="Surface_PointerMoved"
                                      PointerReleased="Surface_PointerReleased" PointerCaptureLost="Surface_CaptureLost"
                                      PointerWheelChanged="Surface_Wheel" DoubleTapped="Surface_DoubleTapped"
                                      SizeChanged="Surface_SizeChanged" ClearColor="Transparent" />
                <Canvas x:Name="TextLayer">
                    <TextBox x:Name="TextEntry" Visibility="Collapsed" MinWidth="120" AcceptsReturn="True" TextWrapping="NoWrap"
                             PlaceholderText="Type, Enter to place" KeyDown="TextEntry_KeyDown" LostFocus="TextEntry_LostFocus" />
                </Canvas>
                <Grid Margin="12" VerticalAlignment="Bottom" ColumnSpacing="12" IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="10,5" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                        <TextBlock x:Name="Hint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="1" Padding="4,2" CornerRadius="6" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Style="{StaticResource BarButton}" Content="&#x2212;" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out" />
                            <TextBlock x:Name="ZoomText" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}" />
                            <Button Style="{StaticResource BarButton}" Content="+" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in" />
                            <Button Style="{StaticResource BarButton}" Content="Fit" Click="ZoomFit_Click" ToolTipService.ToolTip="Fit to window (0)" />
                            <Button Style="{StaticResource BarButton}" Content="100%" Click="ZoomActual_Click" ToolTipService.ToolTip="Actual size (1)" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Options for the current tool / selection -->
            <StackPanel Grid.Row="1" Grid.Column="2" Padding="16,14" Spacing="18" BorderThickness="1,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <TextBlock x:Name="InspectorTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel x:Name="ColorPanel" Spacing="8">
                    <TextBlock Text="Color" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="34" ItemHeight="32" />
                </StackPanel>
                <StackPanel x:Name="WidthPanel" Spacing="4">
                    <TextBlock x:Name="WidthLabel" Text="Thickness · 4 px" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="WidthSlider" Minimum="1" Maximum="24" Value="4" StepFrequency="1" ValueChanged="WidthSlider_ValueChanged" />
                </StackPanel>
                <StackPanel x:Name="FontPanel" Spacing="4">
                    <TextBlock x:Name="FontLabel" Text="Text size · 22 px" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="FontSlider" Minimum="10" Maximum="96" Value="22" StepFrequency="1" ValueChanged="FontSlider_ValueChanged" />
                </StackPanel>
                <StackPanel x:Name="CropPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="CropInfo" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Apply crop" HorizontalAlignment="Stretch" Click="ApplyCrop_Click" ToolTipService.ToolTip="Enter" />
                    <Button Content="Reset to full image" HorizontalAlignment="Stretch" Click="ResetCrop_Click" />
                </StackPanel>
                <Button x:Name="DeleteBtn" Visibility="Collapsed" HorizontalAlignment="Stretch" Click="Delete_Click" ToolTipService.ToolTip="Delete">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Delete" /></StackPanel>
                </Button>
                <TextBlock x:Name="InspectorTip" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SavedText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Video trim -->
        <Grid x:Name="VideoEditor" Visibility="Collapsed" Padding="24,4,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="VideoName" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="VideoInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <MediaPlayerElement x:Name="Player" Grid.Row="1" AreTransportControlsEnabled="True" Stretch="Uniform" />
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,12">
                <Grid RowSpacing="8" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start" VerticalAlignment="Center" />
                    <Slider x:Name="TrimStart" Grid.Column="1" StepFrequency="0.1" ValueChanged="Trim_ValueChanged" />
                    <TextBlock Grid.Row="1" Text="End" VerticalAlignment="Center" />
                    <Slider x:Name="TrimEnd" Grid.Row="1" Grid.Column="1" StepFrequency="0.1" ValueChanged="Trim_ValueChanged" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrimInfo" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        <ToggleSwitch x:Name="SnapKeyframes" Grid.Column="1" IsOn="True" OnContent="Snap to keyframes (instant)" OffContent="Exact frame (re-encodes)" />
                        <Button x:Name="SaveTrim" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="SaveTrim_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C6;" FontSize="14" /><TextBlock Text="Save trimmed" /></StackPanel>
                        </Button>
                    </Grid>
                    <ProgressBar x:Name="TrimProgress" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Maximum="100" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
